# --- ETAPA 1: Base ---
FROM node:22-slim@sha256:7bc0f8252277d33eb4fdf569c735d46ec8787c8052cf7c1f80219c6934c9c2dd AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm:/pnpm/bin:$PATH"
RUN corepack enable

# --- ETAPA 2: Pruning ---
FROM base AS pruner
WORKDIR /app
RUN pnpm add -g turbo@2.10.5
COPY . .
RUN turbo prune @economic-control/client --docker

# --- ETAPA 3: Builder ---
FROM base AS builder
WORKDIR /app

ARG VITE_API_URL
ARG VITE_API_PREFIX

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_PREFIX=$VITE_API_PREFIX

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./

RUN pnpm turbo run build --filter=@economic-control/shared
RUN pnpm turbo run build --filter=@economic-control/client

# --- ETAPA 4: Servidor Nginx (Producción) ---
# Imagen oficial sin privilegios configurada para ejecutar como usuario 'nginx'
FROM nginxinc/nginx-unprivileged:alpine@sha256:0d96d2bdaecfa62ce0ed7a8aabf29910404a3f12467d5e49aef5314a4fc5f903 AS runner

# El usuario 'nginx' ya tiene permisos sobre este directorio en la imagen unprivileged
COPY packages/client/nginx.conf /etc/nginx/conf.d/default.conf

RUN rm -rf /usr/share/nginx/html/*

# Copiamos la build blindando la propiedad hacia el usuario 'nginx'
COPY --from=builder --chown=nginx:nginx /app/packages/client/dist /usr/share/nginx/html

# Los usuarios sin privilegios (no-root) no pueden exponer puertos por debajo del 1024
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]