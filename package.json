{
  "name": "economic-control-root",
  "version": "0.0.1",
  "private": true,
  "description": "Configuration root package for Economic Control monorepo",
  "scripts": {
    "install:all": "pnpm install",
    "db:setup": "dotenv -e .env -- turbo run db:setup --filter=@economic-control/server",
    "initial": "pnpm install && dotenv -e .env -- turbo run build && pnpm db:setup",
    "dev": "dotenv -e .env -- turbo dev",
    "build": "dotenv -e .env -- turbo build",
    "clean": "turbo clean && rm -rf node_modules .turbo packages/**/node_modules",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "sequelize-cli": "^6.6.5",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.32.0+sha512.9b2634bb3fed5601c33633f2d92593f506270a3963b8c51d2b2d6a828da615ce4e9deebef9614ccebbc13ac8d3c0f9c9ccceb583c69c8578436fa477dbb20d70"
}
